# Copy to .env and fill in locally. .env is git-ignored. Never commit real keys.
# Nothing in the skeleton reads these yet; they are placeholders for the beta.

# Vision model used for image -> LaTeX and figure alt text (provider not chosen yet).
VISION_MODEL_PROVIDER=
VISION_MODEL_NAME=
VISION_MODEL_API_KEY=

# Fallback model per step (decision pending, see docs/decisions/0001-scope.md).
FALLBACK_MODEL_NAME=
FALLBACK_MODEL_API_KEY=

# Cost controls (Harish sets the numbers; no defaults on purpose).
DAILY_SPEND_CAP_USD=
PER_USER_DAILY_PAGE_QUOTA=

# Tracing (off for any private-inputs/ run).
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=
TRACING_ENABLED=false
