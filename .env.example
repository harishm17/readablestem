# Copy to .env and fill in locally. .env is git-ignored. Never commit real keys.
# Every name here is a field of readablestem.config.Settings (case-insensitive).
# Production values live in Railway's service variables (see docs/deploy-railway.md, which
# also says which content features are on there). Every default below is the code's own
# (src/readablestem/config.py); a line left blank or commented out uses it.

# --- environment: dev | test | prod (prod refuses to start without the limits below)
ENV=dev

# --- models (ADR 0002). Each model is the other's fallback.
# Which provider answers: openai (default) or anthropic (Claude; docs/deploy.md, "Using
# Claude"). Only the selected provider's key and models are used.
MODEL_PROVIDER=openai
OPENAI_API_KEY=
MAIN_MODEL=gpt-6.1-sol
CHEAP_MODEL=gpt-6-luna
# MODEL_PROVIDER=anthropic: the key, and the model for each role (they replace MAIN_MODEL
# and CHEAP_MODEL, which are then ignored). Any Claude model in models/pricing.py works,
# for example ANTHROPIC_CHEAP_MODEL=claude-sonnet-5-5.
ANTHROPIC_API_KEY=
ANTHROPIC_MAIN_MODEL=claude-opus-5-5
ANTHROPIC_CHEAP_MODEL=claude-haiku-5-5
# Only for a key that is not scoped to a workspace (an organisation-level key): the
# workspace id (wrkspc_...), sent as the anthropic-workspace-id header on every request.
# Leave blank for a workspace-scoped key.
ANTHROPIC_WORKSPACE_ID=
# How hard the Claude models think (low, medium, high, xhigh, max); claude-opus-5-5 cannot
# turn thinking off, so this is the control.
ANTHROPIC_EFFORT_MAIN=medium
ANTHROPIC_EFFORT_CHEAP=low
# Model-cost settings (docs/eval.md, "Model cost"); all but the first are off. Blank = unset.
# The fixed untrusted-text notice rides in the cached system block (measured: same answers,
# 6-10% less per call).
ANTHROPIC_NOTICE_IN_SYSTEM=true
# A lower effort for one step whichever model answers (measured: no saving on the dev sets).
ANTHROPIC_EFFORT_EQUATION=
ANTHROPIC_EFFORT_FIGURE=
# Effort of the page math, page witness and image page passes (blank: low, medium, and the
# image page pass's own default).
ANTHROPIC_EFFORT_PAGE_MATH=
ANTHROPIC_EFFORT_PAGE_WITNESS=
ANTHROPIC_EFFORT_IMAGE_PAGES=
# Reduce figure crops to this many pixels on the long side before the model reads them (about
# 14% less per page on the dev set; no dense figures in it, see docs/eval.md).
FIGURE_MODEL_MAX_EDGE_PX=
# Display equations start on the cheap model (66-76% less per equation; fewer flags, see docs).
EQUATION_DISPLAY_FIRST_CHEAP=false
# The nearby text goes to the main model only on a re-read (no saving measured).
EQUATION_CONTEXT_ON_ESCALATION=false
# Accept bar per model as JSON, e.g. {"claude-sonnet-5-5": 0.80}; empty = AUTO_ACCEPT_CONFIDENCE.
ACCEPT_CONFIDENCE_BY_MODEL=
# Let Anthropic re-run a request its safety classifiers decline on the model it recommends
# (claude-opus-5-5 and claude-sonnet-5-5; claude-haiku-5-5 has none).
ANTHROPIC_REFUSAL_FALLBACK=true
MODEL_TIMEOUT_S=60
MODEL_MAX_RETRIES=2
# Equation, figure and table steps of one conversion that run at once (1 to 16). The worker
# lowers it for a job whose spend cap could not hold that many reservations.
# MODEL_CONCURRENCY=8
AUTO_ACCEPT_CONFIDENCE=0.85
ABSTAIN_CONFIDENCE=0.4
# Dev only: answer every model request offline with placeholder output (no key needed).
FAKE_MODELS=false
# Second automated check, OpenAI Decisions API (ADR 0005, docs/steps.md). Used only with
# MODEL_PROVIDER=openai: with anthropic it is skipped, whatever these say. The figure check
# adds an optional note only; the equation check is a shadow (recorded, changes nothing).
DECISIONS_MODEL=gpt-6-luna
DECISIONS_TIMEOUT_S=10
DECISIONS_FIGURE_VERIFY=true
DECISIONS_FIGURE_FLAG_BELOW=0.5
DECISIONS_EQUATION_SHADOW=true
DECISIONS_EQUATION_FLAG_AT=0.2
# Daily drift canary inside the hourly cron (docs/operations.md, "Decisions canary").
DECISIONS_CANARY=true

# --- cost and abuse limits. Harish sets the money numbers; there are no defaults for them.
DAILY_SPEND_CAP_USD=
PER_USER_DAILY_PAGE_QUOTA=
# Who may sign in: `allowlist` (the default; `readablestem users allow EMAIL`) or `open`
# (anyone with a verified Google account gets an account, with the lower limits below).
# The numbers below are the defaults and apply to accounts that signed themselves up.
SIGNUP_MODE=allowlist
# OPEN_TIER_DAILY_PAGE_QUOTA=150
# OPEN_TIER_DAILY_REREADS=30
# MAX_NEW_ACCOUNTS_PER_DAY=100
# OPEN_TIER_DAILY_SPEND_CAP_USD=4
# Left unset on purpose: the default depends on the provider (OpenAI $6.00 per job and
# $0.30 per page; Claude $6.00 and $1.00). One claude-opus-5-5 call holds up to about $0.14
# while it runs ($0.22 with long descriptions, $0.53 with tables). Set them only to change
# that (docs/deploy.md, "Spend limits").
# MAX_USD_PER_JOB=
MAX_MODEL_CALLS_PER_JOB=1200
# Per page of the upload: a job's caps are at most this many times its page count.
# MAX_USD_PER_PAGE=
MAX_MODEL_CALLS_PER_PAGE=80
MAX_PAGES_PER_JOB=100
MAX_UPLOAD_MB=50
# A larger file (up to these) is kept so the instructor can choose which pages to convert,
# in parts that each fit. The MB is also the most one upload request may carry, files
# together (the old 30 was sized for Cloud Run's 32 MiB request limit). Equal to the two above: such
# files are refused.
MAX_LARGE_UPLOAD_MB=100
MAX_SOURCE_PAGES=500
# Uploads taken in at once per instance (and one per user); bounds upload memory.
MAX_CONCURRENT_UPLOADS=3
# Stored megabytes per person (invited, open tier) and for all uploads together; over the
# last, new uploads are refused until the purge catches up (docs/operations.md).
# STORAGE_PER_USER_MB=300
# STORAGE_OPEN_TIER_MB=250
# STORAGE_GLOBAL_MAX_MB=2000

# --- storage and retention (uploads and results are deleted RETENTION_HOURS after the last
# activity; the person can choose 7 days per upload, or 30 days with opt-in)
DATABASE_URL=sqlite:///.local/readablestem.db
RETENTION_HOURS=24
OPT_IN_RETENTION_DAYS=30

# --- web, sign-in and cron
BASE_URL=http://localhost:8000
SESSION_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Microsoft (Entra ID) sign-in. Off unless all three are set; MS_ALLOWED_TENANTS lists
# directory (tenant) ids, comma-separated. Half of them set refuses to start.
# App registration: docs/deploy.md, step 3b. Locally, register the redirect URI
# http://localhost:8000/auth/microsoft/callback.
MS_CLIENT_ID=
MS_CLIENT_SECRET=
MS_ALLOWED_TENANTS=
# Comma-separated; created as allowed admins at start-up.
ADMIN_EMAILS=
# Earlier SESSION_SECRET values, comma-separated, still accepted for checking a session cookie
# (docs/security.md, "Rotating the session secret").
# SESSION_SECRET_PREVIOUS=
# Proxies in front of the app that write the caller's address into X-Forwarded-For: 1 with
# Railway's or Cloud Run's front end alone, 2 with Cloudflare's proxy as well, 0 with none.
# TRUSTED_PROXY_HOPS=1
# Per-address and per-person rate limits: on, and required in production.
# RATE_LIMITS_ENABLED=true
# Local-only sign-in shortcut (any email, no password). Refused unless ENV=dev or test.
DEV_LOGIN_ENABLED=false
# Sign in by an emailed one-time link. Off. No email provider is wired in: this needs a
# sender to be registered first, and the privacy page to name it.
EMAIL_LOGIN_ENABLED=false
EMAIL_SENDER=
# EMAIL_LINK_MINUTES=15
# Shared secret a scheduler sends as X-Cron-Token to /internal/cron/aggregate-and-purge (the
# Cloud Run path; Railway's cron service runs `readablestem ops cron` and does not use it).
CRON_TOKEN=
RUN_WORKER=true
# Load the table models when the worker starts (production only). Only for a conversion run in
# the web process: the conversion child loads its own.
# PRELOAD_TABLE_MODELS=true
# Address space, in MiB, of the child process each conversion runs in (1536 to 16384). A
# conversion peaks at 1.6-1.8 GB of address space and about 0.45 GB resident.
# CONVERSION_MEMORY_MB=3072
WORKER_POLL_S=2.0

# --- public pages
SOURCE_URL=https://github.com/harishm17/readablestem
CONTACT_EMAIL=
# The footer's Feedback link (http or https). Blank: an email to CONTACT_EMAIL.
FEEDBACK_URL=
# Two questions after a download, and content-free usage events (no document text).
FEEDBACK_QUESTIONS_ENABLED=true
EVENTS_ENABLED=true
# Product analytics through the app's own /m/ proxy (web/analytics.py). Off until the privacy
# notice says so; the script also stays silent on any host but readablestem.com.
ANALYTICS_ENABLED=false

# Reader B for handwritten expressions (docs/math-readers.md); the pipeline calls one only when
# IMAGE_PAGES_SECOND_READER names it. Turning one
# on sends crops to that provider; production refuses it until the privacy notice names it.
MATH_READER_CLAUDE_ENABLED=false
# MATH_READER_CLAUDE_MODEL=claude-sonnet-5-5
# MATH_READER_CLAUDE_EFFORT=medium
MATH_READER_OPENAI_ENABLED=false
# MATH_READER_OPENAI_MODEL=gpt-6-luna
# Local reader (TexTeller on CPU, no key, no network, nothing leaves the server, so it adds no
# recipient). Fetch its files once: python -m readablestem.models.math_readers.local_weights
# --dir .local/math-reader   (the image has them with INSTALL_MATH_READER=true).
MATH_READER_LOCAL_ENABLED=false
# MATH_READER_LOCAL_DIR=.local/math-reader
# MATH_READER_LOCAL_THREADS=2
# MATH_READER_LOCAL_TIME_S=20
# The most the Claude and OpenAI readers together may spend on one job, inside the job's caps.
MATH_READER_MAX_USD_PER_JOB=0.5
# Which reader reads each handwritten display equation a second time, to compare with the page
# reading and offer the differences as choices on the review card: off, local, claude or openai
# (the reader must be enabled above; only local runs in the hosted conversion child).
IMAGE_PAGES_SECOND_READER=off
# IMAGE_PAGES_SECOND_READER_TIME_S=120

# --- content features. Each is off in code until measured; production turns several on
# (docs/deploy-railway.md, "Feature flags in production").
FEATURE_TABLES=false
# Inline equations also sent as their whole line with the span boxed; the model writes the whole
# formula (docs/eval-equation-round3.md: +2.6 points on a registered set, fewer silent errors).
EQUATION_LINE_CONTEXT=false
# An equation's glyphs are kept with it: a reading that reaches past the box is checked against the
# glyphs it covers, and each letter's style (italic, upright, bold italic, script) against the font.
EQUATION_GLYPH_CHECKS=false
# Correct a reading from the PDF's own glyphs where they leave one answer (docs/steps.md,
# "Corrections from the glyphs"). Needs EQUATION_GLYPH_CHECKS. Off until measured.
EQUATION_GLYPH_RECONCILE=false
# Layout joins pieces of one printed display (docs/layout.md "One printed display, one element").
# Off; bump PIPELINE_VERSION in the change that turns it on.
LAYOUT_DISPLAY_GROUPING=false
# A small calibrated rule asks for a decision on accepted equations that look like the wrong ones
# (pipeline/flag_policy.py, docs/eval-flag-policy.md); it only adds decisions.
FLAG_POLICY=false
FEATURE_LONG_DESCRIPTIONS=false
FEATURE_COLOUR=false
FEATURE_NOTATION_MEMORY=false
# A page math pass places each page's equations, grounded in the PDF's text layer (ADR 0006);
# one cheap-model call per page. OFF until a fresh held-out set says it helps.
FEATURE_PAGE_MATH=false
# PAGE_MATH_MODEL=          # blank: the cheap model
# PAGE_MATH_UNCONFIRMED_FACTOR=1.0
# If you turn it on, real LaTeX PDFs want a larger output limit (dense pages overrun 4096) and, to keep
# the review screen asking about as many wrong equations as before, no confidence lift on agreement
# (docs/eval-realworld.md, ADR 0006). Defaults shown.
# PAGE_MATH_MAX_OUTPUT_TOKENS=4096     # 12288 on arXiv-style pages
# PAGE_MATH_AGREEMENT_LIFT=true        # false asks about more equations
# A page witness: one strong-model call per maths page reads every formula; its disagreements with
# the crop readings and the formulas only it found become required decisions (docs/steps.md).
# OFF; first dev measurement in docs/eval-equation-round5.md.
FEATURE_PAGE_WITNESS=false
# PAGE_WITNESS_MODEL=claude-opus-5-5
# PAGE_WITNESS_MAX_OUTPUT_TOKENS=12288
# PAGE_WITNESS_TIMEOUT_S=240
# Scanned and handwritten pages can be read from an image of the page, one vision call per page,
# every converted block a review item (ADR 0007). In the web app this OFFERS an upload option
# ("Convert scanned or handwritten pages"): a job converts them only when its owner ticks it, with
# the main model (IMAGE_PAGES_MODEL blank). Such a job may spend IMAGE_PAGES_USD_PER_PAGE per
# document page, at most IMAGE_PAGES_MAX_USD_PER_JOB, still inside the daily caps and the open pool.
FEATURE_IMAGE_PAGES=false
# LaTeX and Beamer source uploads: needs the image built with INSTALL_LATEXML and a PASS from
# `readablestem ops sandbox-probe` (docs/security.md, "Running uploaded TeX"). The three
# source flags are off in production today: the probe fails on Railway.
FEATURE_LATEX_SOURCE=false
# A .zip of documents (PDFs and LaTeX projects) becomes a batch.
FEATURE_BATCH_ZIP=false
# Beamer decks within LaTeX source (needs FEATURE_LATEX_SOURCE too).
FEATURE_BEAMER_SOURCE=false
IMAGE_PAGES_MODEL=
IMAGE_PAGES_USD_PER_PAGE=0.25
IMAGE_PAGES_MAX_USD_PER_JOB=7.5
# Tuning of the image page pass (defaults shown; docs/eval-handwriting.md, docs/eval-image-pages.md):
# IMAGE_PAGES_TIMEOUT_S=180
# IMAGE_PAGES_DPI=200
# IMAGE_PAGES_OMISSION_CHECK=true
# IMAGE_PAGES_MATHS_ALWAYS_REQUIRED=true
# IMAGE_PAGES_RECOVER_OMISSIONS=true
# IMAGE_PAGES_VECTOR_CHECKS=true
# IMAGE_PAGES_VECTOR_CROPS=false         # off until measured
# IMAGE_PAGES_SECOND_READING=false      # off until measured
# IMAGE_PAGES_ACCEPT_AGREED=false
# alttext on each <math> from the stored speech; OFF until checked by hand with NVDA +
# MathCAT (docs/mathml-alttext.md)
MATHML_ALTTEXT=false

# --- second automated check on Claude (MODEL_PROVIDER=anthropic only; docs/steps.md)
# off | shadow (asks and records, changes nothing; default) | enforce (figures: optional note)
CLAUDE_SECOND_CHECK=shadow
# a different model from the ones that read the page (ANTHROPIC_MAIN_MODEL / _CHEAP_MODEL)
CLAUDE_CHECK_MODEL=claude-sonnet-5-5
CLAUDE_CHECK_EFFORT=low
CLAUDE_CHECK_TIMEOUT_S=45
# accepted (default) | all (also equations already waiting for review)
CLAUDE_CHECK_SCOPE=accepted
# daily canary on 12 synthetic cases with known answers (ops/claude_canary.py)
CLAUDE_CANARY=true
CLAUDE_CANARY_MAX_MISSES=1

# --- tracing (off by default; inputs masked; never on for private-inputs/ runs)
TRACING_ENABLED=false
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=

LOG_LEVEL=INFO
# The web process runs the sandbox probe itself at start-up when LaTeXML is installed; LaTeX
# source is refused unless it passed (/healthz/ops, "sandbox").
SANDBOX_PROBE_AT_STARTUP=true
SANDBOX_PROBE_TIMEOUT_S=240
# The most memory (MB) one source conversion may use in all; `ops sandbox-probe --require-latexml`
# fails when the sandbox's limits add up to more.
# SOURCE_SANDBOX_MAX_TOTAL_MB=2048
# Word and PowerPoint uploads: taken only where LibreOffice is installed (the image built with
# INSTALL_LIBREOFFICE=true). SOFFICE_PATH names the program when it is not `soffice` on PATH.
# OFFICE_INPUT_ENABLED=true
# SOFFICE_PATH=
# OFFICE_TIMEOUT_S=90
