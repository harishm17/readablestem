# Copy to .env and fill in locally. .env is git-ignored. Never commit real keys.
# Every name here is a field of a11y_stem.config.Settings (case-insensitive).
# Production values live in Secret Manager / Cloud Run env vars (see docs/deploy.md).

# --- environment: dev | test | prod (prod refuses to start without the limits below)
ENV=dev

# --- models (ADR 0002). Each model is the other's fallback.
# Which provider answers: openai (default) or anthropic (Claude; docs/deploy.md, "Using
# Claude"). Only the selected provider's key and models are used.
MODEL_PROVIDER=openai
OPENAI_API_KEY=
MAIN_MODEL=gpt-6.1-sol
CHEAP_MODEL=gpt-6-luna
# MODEL_PROVIDER=anthropic: the key, and the model for each role (they replace MAIN_MODEL
# and CHEAP_MODEL, which are then ignored). Any Claude model in models/pricing.py works,
# for example ANTHROPIC_CHEAP_MODEL=claude-sonnet-5-5.
ANTHROPIC_API_KEY=
ANTHROPIC_MAIN_MODEL=claude-opus-5-5
ANTHROPIC_CHEAP_MODEL=claude-haiku-5-5
# Only for a key that is not scoped to a workspace (an organisation-level key): the
# workspace id (wrkspc_...), sent as the anthropic-workspace-id header on every request.
# Leave blank for a workspace-scoped key.
ANTHROPIC_WORKSPACE_ID=
# How hard the Claude models think (low, medium, high, xhigh, max); claude-opus-5-5 cannot
# turn thinking off, so this is the control.
ANTHROPIC_EFFORT_MAIN=medium
ANTHROPIC_EFFORT_CHEAP=low
# Let Anthropic re-run a request its safety classifiers decline on the model it recommends
# (claude-opus-5-5 and claude-sonnet-5-5; claude-haiku-5-5 has none).
ANTHROPIC_REFUSAL_FALLBACK=true
MODEL_TIMEOUT_S=60
MODEL_MAX_RETRIES=2
# Equation, figure and table steps of one conversion that run at once (1 to 16). The worker
# lowers it for a job whose spend cap could not hold that many reservations.
# MODEL_CONCURRENCY=8
AUTO_ACCEPT_CONFIDENCE=0.85
ABSTAIN_CONFIDENCE=0.4
# Dev only: answer every model request offline with placeholder output (no key needed).
FAKE_MODELS=false
# Second automated check, OpenAI Decisions API (ADR 0005, docs/steps.md). Used only with
# MODEL_PROVIDER=openai: with anthropic it is skipped, whatever these say. The figure check
# adds an optional note only; the equation check is a shadow (recorded, changes nothing).
DECISIONS_MODEL=gpt-6-luna
DECISIONS_TIMEOUT_S=10
DECISIONS_FIGURE_VERIFY=true
DECISIONS_FIGURE_FLAG_BELOW=0.5
DECISIONS_EQUATION_SHADOW=true
DECISIONS_EQUATION_FLAG_AT=0.2
# Daily drift canary inside the hourly cron (docs/operations.md, "Decisions canary").
DECISIONS_CANARY=true

# --- cost and abuse limits. Harish sets the money numbers; there are no defaults for them.
DAILY_SPEND_CAP_USD=
PER_USER_DAILY_PAGE_QUOTA=
# Left unset on purpose: the default depends on the provider (OpenAI $2.00 per job and
# $0.30 per page; Claude $4.00 and $2.00, because one claude-opus-5-5 call holds about
# $0.30 while it runs). Set them only to change that (docs/deploy.md, "Spend limits").
# MAX_USD_PER_JOB=
MAX_MODEL_CALLS_PER_JOB=400
# Per page of the upload: a job's caps are at most this many times its page count.
# MAX_USD_PER_PAGE=
MAX_MODEL_CALLS_PER_PAGE=80
MAX_PAGES_PER_JOB=30
MAX_UPLOAD_MB=20
# Uploads taken in at once per instance (and one per user); bounds upload memory.
MAX_CONCURRENT_UPLOADS=3

# --- storage and retention (uploads and results deleted after 24 h; 30 days with opt-in)
DATABASE_URL=sqlite:///.local/a11y-stem.db
RETENTION_HOURS=24
OPT_IN_RETENTION_DAYS=30

# --- web, sign-in and cron
BASE_URL=http://localhost:8000
SESSION_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Microsoft (Entra ID) sign-in. Off unless all three are set; MS_ALLOWED_TENANTS lists
# directory (tenant) ids, comma-separated. Half of them set refuses to start.
# App registration: docs/deploy.md, step 3b. Locally, register the redirect URI
# http://localhost:8000/auth/microsoft/callback.
MS_CLIENT_ID=
MS_CLIENT_SECRET=
MS_ALLOWED_TENANTS=
# Comma-separated; created as allowed admins at start-up.
ADMIN_EMAILS=
# Local-only sign-in shortcut (any email, no password). Refused unless ENV=dev or test.
DEV_LOGIN_ENABLED=false
# Shared secret Cloud Scheduler sends as X-Cron-Token to /internal/cron/aggregate-and-purge.
CRON_TOKEN=
RUN_WORKER=true
# Load the table models when the worker starts (production only).
# PRELOAD_TABLE_MODELS=true
WORKER_POLL_S=2.0

# --- public pages
SOURCE_URL=https://github.com/harishm17/a11y-stem
CONTACT_EMAIL=
# Two questions after a download, and content-free usage events (no document text).
FEEDBACK_QUESTIONS_ENABLED=true
EVENTS_ENABLED=true

# --- content features (docs/design/content-features.md); each off until measured
FEATURE_TABLES=false
FEATURE_LONG_DESCRIPTIONS=false
FEATURE_COLOUR=false
FEATURE_NOTATION_MEMORY=false

# --- tracing (off by default; inputs masked; never on for private-inputs/ runs)
TRACING_ENABLED=false
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=

LOG_LEVEL=INFO
