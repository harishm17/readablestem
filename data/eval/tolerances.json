    {"name": "cost_per_equation", "task": "equations", "path": "cost.per_item_usd", "rule": "max_rel_increase", "limit": 0.25},
    {"name": "heading_recall", "task": "headings", "path": "metrics.recall", "rule": "max_drop", "limit": 0.03},
