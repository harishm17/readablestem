{"archive_version": "20260604.144757", "book_slug": "statistics", "book_state": "live", "book_title": "Statistics", "book_uuid": "394a1101-fd8f-4875-84fa-55f15b06ba66", "book_version": "7dea80a", "caption": "Frequency Table of Soccer Player Height", "content_url": "https://openstax.org/apps/archive/20260604.144757/contents/394a1101-fd8f-4875-84fa-55f15b06ba66@7dea80a:612a41bd-af15-4883-9e0f-24173501af5e.json", "context": null, "element_id": "id9703284", "has_thead": true, "header_cells": [{"col": 0, "row": 0, "scope": "col", "text": "HEIGHTS (INCHES)"}, {"col": 1, "row": 0, "scope": "col", "text": "FREQUENCY"}, {"col": 2, "row": 0, "scope": "col", "text": "RELATIVE FREQUENCY"}, {"col": 3, "row": 0, "scope": "col", "text": "CUMULATIVE RELATIVE FREQUENCY"}], "html": "<table id=\"id9703284\" data-summary=\"This table presents a range of heights in inches in the first column, the number of students whose height falls within that range in the second column, the relative frequency of students in this range (expressed as both a fraction and a decimal) in the third column, and the cumulative relative frequency (expressed as a sum of current and previous relative frequency values) in the fourth column.\"><thead>\n<tr>\n<th data-align=\"center\" scope=\"col\">HEIGHTS <span data-type=\"newline\"><br /></span>(INCHES)</th>\n<th data-align=\"center\" scope=\"col\">FREQUENCY</th>\n<th data-align=\"center\" scope=\"col\">RELATIVE <span data-type=\"newline\"><br /></span>FREQUENCY</th>\n<th data-align=\"center\" scope=\"col\">CUMULATIVE <span data-type=\"newline\"><br /></span>RELATIVE <span data-type=\"newline\"><br /></span>FREQUENCY</th>\n</tr>\n</thead><tbody>\n<tr>\n<td data-align=\"center\"><span data-type=\"emphasis\" class=\"normal\" data-effect=\"normal\">59.95–61.95</span></td>\n<td data-align=\"center\">5</td>\n<td data-align=\"center\">\n<math display=\"inline\"><semantics><mrow>\n <mrow>\n  <mfrac>\n   <mn>5</mn>\n   <mrow>\n    <mn>100</mn>\n   </mrow>\n  </mfrac>\n <