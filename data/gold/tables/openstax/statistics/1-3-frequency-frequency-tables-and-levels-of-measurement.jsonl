/mrow></annotation-xml></semantics></math>\n = .40\n</td>\n<td data-align=\"center\">.23 + .40 = .63</td>\n</tr>\n\n<tr>\n<td data-align=\"center\"><span data-type=\"emphasis\" class=\"normal\" data-effect=\"normal\">67.95–69.95</span></td>\n<td data-align=\"center\">17</td>\n<td data-align=\"center\">\n<math display=\"inline\"><semantics><mrow>\n <mrow>\n  <mfrac>\n   <mrow>\n    <mn>17</mn>\n   </mrow>\n   <mrow>\n    <mn>100</mn>\n   </mrow>\n  </mfrac>\n\n </mrow>\n</mrow><annotation-xml encoding=\"MathML-Content\"><mrow>\n  <mfrac>\n   <mrow>\n    <mn>17</mn>\n   </mrow>\n   <mrow>\n    <mn>100</mn>\n   </mrow>\n  </mfrac>\n\n </mrow></annotation-xml></semantics></math>\n = .17\n</td>\n<td data-align=\"center\">.63 + .17 = .80</td>\n</tr>\n\n<tr>\n<td data-align=\"center\"><span data-type=\"emphasis\" class=\"normal\" data-effect=\"normal\">69.95–71.95</span></td>\n<td data-align=\"center\">12</td>\n<td data-align=\"center\">\n<math display=\"inline\"><semantics><mrow>\n <mrow>\n  <mfrac>\n   <mrow>\n    <mn>12</mn>\n   </mrow>\n   <mrow>\n    <mn>100</mn>\n   </mrow>\n  </mfrac>\n\n </mrow>\n</mrow><annotation-xml encoding=\"MathML-Content\"><mrow>\n  <mfrac>\n   <mrow>\n    <mn>12</mn>\n   </mrow>\n   <mrow>\n    <mn>100</mn>\n   </mrow>\n  </mfrac>\n\n </mrow></annotation-xml></semantics></math>\n = .12\n</td>\n<td data-align=\"center\">.80 + .12 = .92</td>\n</tr>\n\n<tr>\n<td data-align=\"center\"><span data-type=\"emphasis\" class=\"normal\" data-effect=\"normal\">71.95–73.95</span></td>\n<td data-align=\"center\">7</td>\n<td data-align=\"center\">\n<math display=\"inline\"><semantics><mrow>\n <mrow>\n  <mfrac>\n   <mn>7</mn>\n   <mrow>\n    <mn>100</mn>\n   </mrow>\n  </mfrac>\n </mrow>\n</mrow><annotation-xml encoding=\"MathML-Content\"><mrow>\n  <mfrac>\n   <mn>7</mn>\n   <mrow>\n    <mn>100</mn>\n   </mrow>\n  </mfrac>\n </mrow></annotation-xml></semantics></math>\n = .07\n</td>\n<td data-align=\"center\">.92 + .07 = .99</td>\n</tr>\n\n<tr>\n<td data-a