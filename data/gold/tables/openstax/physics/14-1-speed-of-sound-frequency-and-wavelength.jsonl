1960</td>\n</tr>\n<tr>\n<td>Aluminum</td>\n<td>5120</td>\n</tr>\n<tr>\n<td>Steel</td>\n<td>5960</td>\n</tr>\n</tbody></table>", "id": "openstax/physics/14-1-speed-of-sound-frequency-and-wavelength/tab-001", "index_on_page": 1, "is_layout": false, "kind": "table", "license_name": "Creative Commons Attribution License", "license_url": "http://creativecommons.org/licenses/by/4.0/", "n_cols": 2, "n_rows": 21, "page_slug": "14-1-speed-of-sound-frequency-and-wavelength", "page_title": "14.1 Speed of Sound, Frequency, and Wavelength", "page_uuid": "9f862e6d-b699-4622-bd6c-fe3bc3034515", "retrieved_at": "2026-10-08", "role": null, "source": "openstax", "source_url": "https://openstax.org/books/physics/pages/14-1-speed-of-sound-frequency-and-wavelength#Table_14_01", "summary": "This table gives the speed of sound in different media. It has two columns. The left column gives a list of media, classified as gases, liquids and solids. The right column gives the speed of sound in each given medium.", "table_number": "14.1"}
