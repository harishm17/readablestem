{"archive_version": null, "book_slug": "authored-html", "book_state": "authored", "book_title": "Authored documents (HTML)", "book_uuid": null, "book_version": "1", "classes": ["code_block"], "content_url": null, "id": "authored/html-code-glossary/cd-000", "index_on_page": 0, "kind": "code", "language": "python", "license_name": "MIT License", "license_url": "https://opensource.org/licenses/MIT", "page": 0, "page_slug": "html-code-glossary", "page_title": "Programming and Mathematics Study Guide", "page_uuid": null, "pdf": "authored/html-code-glossary/html-code-glossary.pdf", "retrieved_at": "2026-10-14", "source": "authored", "source_url": null, "text": "def bisect(f, lo, hi, tol=1e-9):\n    # f(lo) and f(hi) must have opposite signs\n    while hi - lo > tol:\n        mid = (lo + hi) / 2\n        if f(lo) * f(mid) <= 0:\n            hi = mid\n        else:\n            lo = mid\n    return (lo + hi) / 2", "toolchain": "chromium", "variant": "dev"}
{"archive_version": null, "book_slug": "authored-html", "book_state": "authored", "book_title": "Authored documents (HTML)", "book_uuid": null, "book_version": "1", "classes": ["code_block"], "content_url": null, "id": "authored/html-code-glossary/cd-001", "index_on_page": 1, "kind": "code", "language": "python", "license_name": "MIT License", "license_url": "https://opensource.org/licenses/MIT", "page": 0, "page_slug": "html-code-glossary", "page_title": "Programming and Mathematics Study Guide", "page_uuid": null, "pdf": "authored/html-code-glossary/html-code-glossary.pdf", "retrieved_at": "2026-10-14", "source": "authored", "source_url": null, "text": "def trapezoid(f, a, b, n=100):\n    h = (b - a) / n\n    total = (f(a) + f(b)) / 2\n    for k in range(1, n):\n        total += f(a + k * h)\n    return total * h", "toolchain": "chromium", "variant": "dev"}
{"archive_version": null, "book_slug": "authored-html", "book_state": "authored", "book_title": "Authored documents (HTML)", "book_uuid": null, "book_version": "1", "classes": ["code_block"], "content_url": null, "id": "authored/html-code-glossary/cd-002", "index_on_page": 2, "kind": "code", "language": "python", "license_name": "MIT License", "license_url": "https://opensource.org/licenses/MIT", "page": 0, "page_slug": "html-code-glossary", "page_title": "Programming and Mathematics Study Guide", "page_uuid": null, "pdf": "authored/html-code-glossary/html-code-glossary.pdf", "retrieved_at": "2026-10-14", "source": "authored", "source_url": null, "text": "def newton(f, df, x, steps=8):\n    for _ in range(steps):\n        x = x - f(x) / df(x)\n    return x\n\nprint(newton(lambda t: t * t - 2, lambda t: 2 * t, 1.0))", "toolchain": "chromium", "variant": "dev"}
