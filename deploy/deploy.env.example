# Settings for deploy/deploy.sh. Copy to deploy/.env.deploy (git-ignored by the `.env.*`
# rule), fill in, then:
#
#   set -a; . deploy/.env.deploy; set +a
#   ./deploy/deploy.sh
#
# Leave the secret values below empty: the script asks for them with hidden input on
# the first run and stores them in Secret Manager (ANTHROPIC_API_KEY as the secret
# anthropic-api-key, which Cloud Run mounts as an environment variable). Never commit a filled-in copy.

# --- Google Cloud (use a project created only for this app)
PROJECT_ID=
# Pick a region that supports Cloud Run domain mappings if you will use one, for example
# us-central1, us-east1, us-east4, us-west1, europe-west1 (full list in docs/deploy.md).
REGION=us-central1
# Billing account for the monthly budget alert (gcloud billing accounts list). Required
# unless SKIP_BUDGET=true. The fixed cost of this setup is about $57 a month before any
# OpenAI spend (docs/deploy.md, "What it costs"); the default budget is about 1.5x that.
# TODO(Harish): confirm BUDGET_USD against the pricing calculator for your region.
BILLING_ACCOUNT_ID=
BUDGET_USD=90
SKIP_BUDGET=false

# --- The app (all required; the app refuses to start in production without them)
# Production host: https://readablestem.com (the service's run.app URL until the domain is mapped).
BASE_URL=https://
# The money limits, sized for a beta of 3-5 instructors on Claude (docs/deploy.md, "Spend
# limits"). A dense page costs up to about $0.015 and a 100-page document at most $1.50; one
# person converting the 300-page quota is $4.50, and the daily cap also covers the calls in
# flight (about $1.80 for two instances at once). The service refuses to start, and this script
# stops before deploying, if a number cannot work for MODEL_PROVIDER. With
# MODEL_PROVIDER=openai the same numbers are fine.
DAILY_SPEND_CAP_USD=10
PER_USER_DAILY_PAGE_QUOTA=300
# Who may sign in (docs/web.md, "Sign-up modes and access tiers"). `open`: anyone with a
# verified Google account gets an account at the first sign-in, with the lower limits below.
# `allowlist` (the app's default): only people added in Admin. The four numbers apply only to
# accounts that signed themselves up. The spend pool is inside DAILY_SPEND_CAP_USD, not extra.
SIGNUP_MODE=open
OPEN_TIER_DAILY_PAGE_QUOTA=150
OPEN_TIER_DAILY_REREADS=30
MAX_NEW_ACCOUNTS_PER_DAY=100
OPEN_TIER_DAILY_SPEND_CAP_USD=4
GOOGLE_CLIENT_ID=
CONTACT_EMAIL=
# Comma-separated emails that become admins on startup.
ADMIN_EMAILS=
# Where uptime and budget alerts go.
ALERT_EMAIL=

# --- Optional: Microsoft (Entra ID) sign-in for university accounts (docs/deploy.md,
# step 3b). Leave MS_CLIENT_ID empty to offer Google only. With it set, list the
# directory (tenant) ids allowed to sign in, comma-separated; the client secret is asked
# for at the prompt below.
MS_CLIENT_ID=
MS_ALLOWED_TENANTS=

# --- Optional app limits (defaults live in src/readablestem/config.py)
# Leave the two dollar caps empty with FEATURE_TABLES=false: the default depends on the
# provider (Claude: $6.00 a job and $1.00 a page; OpenAI: $6.00 and $0.30). Set them only on
# purpose: a Claude page cap under about $0.60 cannot hold four calls at once, and the app
# refuses to start with it. With FEATURE_TABLES=true on Claude the page cap must be at least
# 0.53 (the default $1.00 passes `ops launch-check`, but lets a one-page job hold one call at a
# time); MAX_USD_PER_PAGE=2.20 holds four calls at once on a one-page job; the job cap's default
# $6.00 is above the minimum $5.71.
MAX_USD_PER_JOB=6.00
MAX_USD_PER_PAGE=2.20
# MAX_PAGES_PER_JOB is 100 and MAX_UPLOAD_MB 50 unless set, MAX_LARGE_UPLOAD_MB 100 (a request that
# size). Cloud Run refuses a request over 32 MiB: for it set MAX_LARGE_UPLOAD_MB=30 (and
# MAX_UPLOAD_MB=30 or less), and give the service MEMORY=2Gi for 100-page uploads.
MAX_PAGES_PER_JOB=
RETENTION_HOURS=

# --- Content features (docs/deploy.md, "Content features"). The beta values, and why. This script
# passes only the four FEATURE_* switches below (and FEEDBACK_URL); the other flags in config.py
# (image pages, equation checks, LaTeX source) keep their code defaults on Cloud Run.
# - long descriptions ON: a complex figure gets a long description and a data table, which
#   is what a blind student needs from a chart. It roughly doubles figure cost (a 30-page
#   document went from $0.13 to $0.21) and every one is a review decision.
# - notation memory ON: the equation step reads a course's notation hints, so a second
#   chapter of the same course comes out more consistent. It keeps course names and
#   notation (the privacy page says so; `ops launch-check` checks it does).
# - tables ON: the owner's decision of 2026-10-21 (docs/tables.md, "The decision"). A table
#   becomes a real <table> for about $0.007 per table; off, it stays an image with a required
#   decision and its formulas are lost. On raises the worst-case reservation to about $0.53 a
#   call, hence the two caps above. Tables the detector misses (unruled lists, long wrapped
#   text) stay as they were with the flag off.
# - colour OFF: off by default; no eval has turned it on.
FEATURE_LONG_DESCRIPTIONS=true
FEATURE_NOTATION_MEMORY=true
FEATURE_TABLES=true
FEATURE_COLOUR=false
# The footer's Feedback link (http or https). Empty: an email to CONTACT_EMAIL. A form
# service is a new data processor: name it on the privacy page first.
FEEDBACK_URL=
# The OpenAI Decisions API second check. With MODEL_PROVIDER=anthropic the script writes all
# three as false and the app ignores them; with openai, leave these empty for the app's
# defaults (all on) or set true/false.
DECISIONS_FIGURE_VERIFY=
DECISIONS_EQUATION_SHADOW=
DECISIONS_CANARY=

# --- Cloud Run sizing (docs/deploy.md, "Sizing"; measured on 1 vCPU). One instance is always
# up because the worker thread lives in it; two at most because of Cloud SQL connections.
CPU=1
MEMORY=1Gi
MIN_INSTANCES=1
MAX_INSTANCES=2
CONCURRENCY=20
REQUEST_TIMEOUT=300

# --- Database: "cloudsql" (default: creates a db-f1-micro instance) or "external"
DB_MODE=cloudsql
SQL_TIER=db-f1-micro
# Daily backups kept (1-365). Each holds every document present when it ran, so deleted
# documents survive in backups until they roll over (docs/deploy.md, "Backups").
SQL_RETAINED_BACKUPS=1
# Only for DB_MODE=external; better left empty and typed at the hidden prompt.
EXTERNAL_DATABASE_URL=

# --- Model provider: anthropic (Claude) or openai (docs/deploy.md, "Using Claude"). Only
# the selected provider's key is asked for and given to the service; with anthropic the
# OpenAI key is neither asked for nor needed. The script's own default is openai, so set it.
MODEL_PROVIDER=anthropic
# anthropic only. A key that is not scoped to a workspace needs this workspace id (wrkspc_...;
# leave empty for a key made inside a workspace). The models default to claude-opus-5-5
# (main, thinking effort medium) and claude-haiku-5-5 (cheap, effort low).
ANTHROPIC_WORKSPACE_ID=
ANTHROPIC_MAIN_MODEL=
ANTHROPIC_CHEAP_MODEL=
ANTHROPIC_EFFORT_MAIN=
ANTHROPIC_EFFORT_CHEAP=

# --- Secrets: leave empty and type them at the prompt (first run only).
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GOOGLE_CLIENT_SECRET=
# Only when MS_CLIENT_ID is set.
MS_CLIENT_SECRET=

# --- Tracing (off unless you set TRACING_ENABLED=true; the secret key is prompted for)
TRACING_ENABLED=false
LANGFUSE_PUBLIC_KEY=
LANGFUSE_HOST=

# --- Uptime check host (default: the service's run.app host). Set to your custom domain
# once its certificate is active.
UPTIME_HOST=
