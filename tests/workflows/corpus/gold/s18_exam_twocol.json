   {"role": "list", "text": "b) Mesosphere"},
   {"role": "list", "text": "c) Troposphere"},
   {"role": "list", "text": "d) Thermosphere"},
   {"role": "body", "text": "7. A population that grows until it reaches the carrying capacity follows"},
   {"role": "list", "text": "a) exponential growth"},
   {"role": "list", "text": "b) logistic growth"},
   {"role": "list", "text": "c) linear growth"},
   {"role": "list", "text": "d) random growth"},
   {"role": "body", "text": "8. Excess nutrients in a lake most directly cause"},
   {"role": "list", "text": "a) eutrophication"},
   {"role": "list", "text": "b) acid rain"},
   {"role": "list", "text": "c) erosion"},
   {"role": "list", "text": "d) desertification"},
