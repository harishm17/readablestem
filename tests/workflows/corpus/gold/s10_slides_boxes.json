   {"role": "heading", "text": "Field kit versus lab instrument"},
   {"role": "heading", "text": "Field kit"},
   {"role": "list", "text": "Easy to repeat"},
   {"role": "list", "text": "Cheap equipment"},
   {"role": "list", "text": "Results in minutes"},
   {"role": "list", "text": "Good for teaching"},
   {"role": "heading", "text": "Lab instrument"},
   {"role": "list", "text": "Low precision"},
   {"role": "list", "text": "Affected by wind"},
   {"role": "list", "text": "Needs trained observer"},
   {"role": "list", "text": "Hard to automate"},
